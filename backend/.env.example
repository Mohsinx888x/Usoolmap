# Copy to .env for local development (never commit it). Placeholders only: no real secrets here.
# In Azure these are set by infra/main.bicep; the secret ones are Key Vault references.

ROLE=all                      # api | worker | all
PORT=8080
LOG_LEVEL=info

# --- secrets (Key Vault in Azure) ---
TOKEN_SECRET=change-me        # signs device tokens; changing it logs every phone out
APP_KEY=change-me             # the phone sends it as X-App-Key when registering
ADMIN_KEY=change-me           # X-Admin-Key for /v1/admin/*
DATABASE_URL=postgres://user:password@localhost:5432/usoolmap
XAI_API_KEY=change-me
AZURE_SPEECH_KEY=change-me

# --- services ---
AZURE_SPEECH_REGION=qatarcentral
GROK_MODEL=latest
# Storage: a connection string wins; without one the managed identity is used with the account name.
# For the local Azurite emulator: AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
BLOB_CONTAINER=clips
QUEUE_NAME=voice-jobs

# --- behaviour ---
NON_REPEAT_DAYS=90            # a device is not given the same clip again within this many days
DAILY_DEVICE_QUOTA=20         # generation jobs one device may cause per UTC day
MAX_JOBS_PER_REQUEST=3
STARTER_PER_EVENT=3
SIMILARITY_THRESHOLD=0.55     # lexical (shingle Jaccard) similarity at which a new joke is rejected
PENDING_JOB_TTL_MINUTES=30
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_MINUTE=30
JOB_VISIBILITY_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=4
WORKER_POLL_SECONDS=5

# --- cost control ---
# PLACEHOLDER PRICES. Set them from your own xAI and Azure price sheets before trusting the estimate.
DAILY_BUDGET_USD=5
PRICE_GROK_PER_CALL_USD=0.002
PRICE_TTS_PER_MILLION_CHARS_USD=16
